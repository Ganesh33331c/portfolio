# Comma-separated allowed frontend origins (add your custom domain)
CORS_ORIGINS=http://localhost:3000

# Email via Brevo HTTPS API (recommended on free hosts: SMTP ports are blocked there)
BREVO_API_KEY=
MAIL_FROM=
MAIL_TO=

# Optional SMTP fallback (works locally, not on Render free)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
